# Servidor web
NODE_ENV=development
PORT=3000
SESSION_DAYS=7
# Genera una cadena aleatoria de al menos 32 caracteres. No la publiques.
SESSION_SECRET=CAMBIA_ESTA_CADENA_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
COOKIE_SECURE=false

# Conexion de Node.js a PostgreSQL en Docker
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ecodata
DB_USER=ecodata_web
DB_PASSWORD=
DB_SSL=false
